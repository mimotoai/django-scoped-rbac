{
  "enabledPlugins": {
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "claude-security@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "remember@claude-plugins-official": true,
    "gitlab@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run --group docs make -C docs:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv tree:*)",
      "Bash(uv build:*)",
      "Bash(uv version --short)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(uv publish:*)",
      "Bash(uv version --bump:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
