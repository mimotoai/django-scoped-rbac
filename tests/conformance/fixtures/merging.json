    {
      "name": "some_context_copies_context_grants_only",
      "description": "A default's top-level condition is not copied to __SOME_CONTEXT__ (it applies there already); its context grants are.",
      "defaults": [
        {
          "condition": "a == 3"
        },
        {
          "c1": {
            "http.GET": {
              "app.Thing": "a == 1"
            }
          }
        }
      ],
      "wire": {
        "*": {
          "*": {
            "*": {
              "conditions": [
                {
                  "condition": "a == 3"
                }
              ]
            }
          }
        },
        "__SOME_CONTEXT__": {
          "http.GET": {
            "app.Thing": {
              "conditions": [
                {
                  "condition": "a == 1"
                }
              ]
            }
          }
        },
        "c1": {
          "http.GET": {
            "app.Thing": {
              "conditions": [
                {
                  "condition": "a == 1"
                }
              ]
            }
          }
        }
      },
      "probes": [
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {"a": 1}, "expected": "allowed", "conditions": [{"condition": "a == 1", "decision": "allowed"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {"a": 2}, "expected": "denied", "conditions": [{"condition": "a == 1", "decision": "denied"}, {"condition": "a == 3", "decision": "denied"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {"a": 3}, "expected": "allowed", "conditions": [{"condition": "a == 1", "decision": "denied"}, {"condition": "a == 3", "decision": "allowed"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {}, "expected": "undetermined", "conditions": [{"condition": "a == 1", "decision": "undetermined"}, {"condition": "a == 3", "decision": "undetermined"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": null, "expected": "undetermined", "conditions": [{"condition": "a == 1", "decision": "undetermined"}, {"condition": "a == 3", "decision": "undetermined"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Other", "resource": {"a": 1}, "expected": "denied", "conditions": [{"condition": "a == 3", "decision": "denied"}]},
