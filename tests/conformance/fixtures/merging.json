        {"context": "c1", "action": "http.GET", "resource_type": "app.Other", "resource": null, "expected": "undetermined", "conditions": [{"condition": "a == 3", "decision": "undetermined"}]},
        {"context": "c1", "action": "http.DELETE", "resource_type": "app.Thing", "resource": {"a": 1}, "expected": "denied", "conditions": [{"condition": "a == 3", "decision": "denied"}]},
        {"context": "c1", "action": "http.DELETE", "resource_type": "app.Thing", "resource": {"a": 2}, "expected": "denied", "conditions": [{"condition": "a == 3", "decision": "denied"}]},
