      "probes": [
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {"a": 1}, "expected": "allowed", "conditions": [{"condition": "a == 2", "message": "a must be 2", "decision": "denied"}, {"condition": {"operator": "a_at_least", "min": 3}, "decision": "denied"}, {"condition": {"operator": "istrue"}, "decision": "denied"}, {"condition": "a == 1", "decision": "allowed"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {"a": 2}, "expected": "allowed", "conditions": [{"condition": "a == 2", "message": "a must be 2", "decision": "allowed"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {"a": 3}, "expected": "allowed", "conditions": [{"condition": "a == 2", "message": "a must be 2", "decision": "denied"}, {"condition": {"operator": "a_at_least", "min": 3}, "decision": "allowed"}]},
        {"context": "c1", "action": "http.GET", "resource_type": "app.Thing", "resource": {}, "expected": "undetermined", "conditions": [{"condition": "a == 2", "message": "a must be 2", "decision": "undetermined"}, {"condition": {"operator": "a_at_least", "min": 3}, "decision": "undetermined"}, {"condition": {"operator": "istrue"}, "decision": "denied"}, {"condition": "a == 1", "decision": "undetermined"}]},
