        {"context": "c1", "action": "http.GET", "resource_type": "app.Other", "resource": {"a": 1}, "expected": "allowed", "conditions": [{"condition": {"operator": "istrue"}, "decision": "denied"}, {"condition": "a == 1", "decision": "allowed"}]},
