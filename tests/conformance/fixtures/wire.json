    {
      "name": "wire_conditions",
      "wire_input": {
        "*": {
          "*": {
            "*": {
              "conditions": [
                {
                  "condition": "a == 1"
                }
              ]
            }
          }
        },
        "c1": {
          "http.GET": {
            "app.Thing": {
              "conditions": [
                {
                  "condition": "a == 2",
                  "message": "a must be 2"
                },
                {
                  "condition": {
                    "operator": "a_at_least",
                    "min": 3
                  }
                }
              ]
            },
            "*": {
              "conditions": [
                {
                  "condition": {
                    "operator": "istrue"
                  }
                }
              ]
            }
          }
        }
      },
